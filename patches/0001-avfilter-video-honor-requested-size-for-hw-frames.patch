diff --git a/libavfilter/video.c b/libavfilter/video.c
index 3f23a12c07..b4bf5ff848 100644
--- a/libavfilter/video.c
+++ b/libavfilter/video.c
@@ -64,8 +64,22 @@ AVFrame *ff_default_get_video_buffer2(AVFilterLink *link, int w, int h, int alig
             return NULL;
 
         ret = av_hwframe_get_buffer(li->l.hw_frames_ctx, frame, 0);
-        if (ret < 0)
+        if (ret < 0) {
             av_frame_free(&frame);
+            return frame;
+        }
+
+        /* av_hwframe_get_buffer() returns a frame sized to the (possibly
+         * alignment-padded) surface dimensions of the frames context. Honor
+         * the caller's requested logical dimensions instead, matching the
+         * software allocation path below. Otherwise a filter requesting a
+         * writable buffer via ff_inlink_make_frame_writable() (e.g. an in-place
+         * hardware overlay) gets a frame larger than the link, silently
+         * changing the picture size and dropping cropping downstream. */
+        if (frame->width >= w && frame->height >= h) {
+            frame->width  = w;
+            frame->height = h;
+        }
 
         return frame;
     }
