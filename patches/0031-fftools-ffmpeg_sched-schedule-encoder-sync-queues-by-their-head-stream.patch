+int sq_head_stream(const SyncQueue *sq)
+{
+    // until every limiting stream has a timestamp, the queue waits on the
+    // first one that has none
+    if (sq->head_stream < 0) {
+        for (unsigned int i = 0; i < sq->nb_streams; i++) {
+            const SyncQueueStream *st = &sq->streams[i];
+            if (st->limiting && !st->finished && st->head_ts == AV_NOPTS_VALUE)
+                return i;
+        }
+        return -1;
+    }
+
+    if (sq->streams[sq->head_stream].finished)
+        return -1;
+
+    return sq->head_stream;
+}
