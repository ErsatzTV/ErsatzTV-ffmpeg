+// Feeding a limiting stream that its sync queue is not waiting on only grows
+// the queue, whatever the muxer sees.
+static int enc_sq_waits_on_other(const Scheduler *sch, SchedulerNode src)
+{
+    const SchEnc *enc;
+    const SchSyncQueue *sq;
+
+    if (src.type != SCH_NODE_TYPE_ENC)
+        return 0;
+
+    enc = &sch->enc[src.idx];
+    if (enc->sq_idx[0] < 0 || !enc->sq_limiting)
+        return 0;
+
+    sq = &sch->sq_enc[enc->sq_idx[0]];
+    return sq->head_enc >= 0 && sq->head_enc != (int)src.idx;
+}
