diff --git a/libavcodec/qsv.c b/libavcodec/qsv.c
index cd5195a..f951d77 100644
--- a/libavcodec/qsv.c
+++ b/libavcodec/qsv.c
@@ -1024,8 +1024,10 @@ static mfxStatus qsv_frame_get_hdl(mfxHDL pthis, mfxMemId mid, mfxHDL *hdl)
 
     pair_dst->first = pair_src->first;
 
-    if (pair_src->second != (mfxMemId)MFX_INFINITE)
-        pair_dst->second = pair_src->second;
+    /* individual (non-array) textures carry MFX_INFINITE as their index. the
+     * output pair is not guaranteed to be zeroed, and legacy Media SDK runtimes
+     * use its second member as the subresource index, so always write it */
+    pair_dst->second = pair_src->second != (mfxMemId)MFX_INFINITE ? pair_src->second : (mfxMemId)0;
     return MFX_ERR_NONE;
 }
 
