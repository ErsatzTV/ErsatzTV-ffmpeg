     mfxStatus err;
 
     int ret;
@@ -1132,6 +1140,9 @@ int ff_qsv_init_session_frames(AVCodecContext *avctx, mfxSession *psession,
     if (ret < 0)
         return ret;
 
+    qsv_frames_ctx->via_d3d11 = MFXQueryIMPL(session, &impl) == MFX_ERR_NONE &&
+                                MFX_IMPL_VIA_MASK(impl) == MFX_IMPL_VIA_D3D11;
+
     if (!opaque) {
         qsv_frames_ctx->logctx = avctx;
