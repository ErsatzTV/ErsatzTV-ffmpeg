diff --git a/libavutil/hwcontext_qsv.c b/libavutil/hwcontext_qsv.c
index b92c9cb..0c9f983 100644
--- a/libavutil/hwcontext_qsv.c
+++ b/libavutil/hwcontext_qsv.c
@@ -817,13 +817,22 @@ static mfxStatus frame_unlock(mfxHDL pthis, mfxMemId mid, mfxFrameData *ptr)
 
 static mfxStatus frame_get_hdl(mfxHDL pthis, mfxMemId mid, mfxHDL *hdl)
 {
+    AVHWFramesContext *ctx = pthis;
+    QSVDeviceContext *device_priv = ctx->device_ctx->hwctx;
     mfxHDLPair *pair_dst = (mfxHDLPair*)hdl;
     mfxHDLPair *pair_src = (mfxHDLPair*)mid;
 
     pair_dst->first = pair_src->first;
 
+    /* individual (non-array) D3D11 textures carry MFX_INFINITE as their index.
+     * the output pair is not guaranteed to be zeroed, and legacy Media SDK
+     * runtimes use its second member as the subresource index, so write 0.
