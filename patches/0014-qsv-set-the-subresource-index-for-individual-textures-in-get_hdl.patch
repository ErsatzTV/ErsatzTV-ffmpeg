diff --git a/libavcodec/qsv.c b/libavcodec/qsv.c
index cd5195a..7a4588e 100644
--- a/libavcodec/qsv.c
+++ b/libavcodec/qsv.c
@@ -1024,8 +1024,15 @@ static mfxStatus qsv_frame_get_hdl(mfxHDL pthis, mfxMemId mid, mfxHDL *hdl)
 
     pair_dst->first = pair_src->first;
 
+    /* individual (non-array) D3D11 textures carry MFX_INFINITE as their index.
+     * the output pair is not guaranteed to be zeroed, and legacy Media SDK
+     * runtimes use its second member as the subresource index, so write 0.
+     * only D3D11 runtimes pass a pair: VA-API and D3D9 runtimes may pass a
+     * single mfxHDL, where writing the second member overruns the caller */
     if (pair_src->second != (mfxMemId)MFX_INFINITE)
         pair_dst->second = pair_src->second;
+    else if (ctx->via_d3d11)
+        pair_dst->second = (mfxMemId)0;
     return MFX_ERR_NONE;
 }
 
