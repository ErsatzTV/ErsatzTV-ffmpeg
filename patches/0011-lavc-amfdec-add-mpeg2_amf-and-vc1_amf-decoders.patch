diff --git a/libavcodec/amfdec.c b/libavcodec/amfdec.c
index c178d5d912..42e03aa745 100644
--- a/libavcodec/amfdec.c
+++ b/libavcodec/amfdec.c
@@ -110,6 +110,12 @@ static int amf_init_decoder(AVCodecContext *avctx)
         case AV_CODEC_ID_AV1:
             codec_id = AMFVideoDecoderHW_AV1;
             break;
+        case AV_CODEC_ID_MPEG2VIDEO:
+            codec_id = AMFVideoDecoderUVD_MPEG2;
+            break;
+        case AV_CODEC_ID_VC1:
+            codec_id = AMFVideoDecoderUVD_VC1;
+            break;
         default:
             break;
     }
@@ -118,6 +124,28 @@ static int amf_init_decoder(AVCodecContext *avctx)
     res = amf_device_ctx->factory->pVtbl->CreateComponent(amf_device_ctx->factory, amf_device_ctx->context, codec_id, &ctx->decoder);
     AMF_RETURN_IF_FALSE(ctx, res == AMF_OK, AVERROR_ENCODER_NOT_FOUND, "CreateComponent(%ls) failed with error %d\n", codec_id, res);
 
+    // The runtime creates the MPEG-2 and VC-1 components on GPUs that have no
+    // such decoder (newer VCN blocks dropped both), Init() succeeds, and the
+    // first SubmitInput() then fails with AMF_NOT_SUPPORTED followed by a crash
+    // on teardown. Ask for caps up front and refuse cleanly instead.
+    if (avctx->codec->id == AV_CODEC_ID_MPEG2VIDEO || avctx->codec->id == AV_CODEC_ID_VC1) {
+        AMFCaps *caps = NULL;
+        AMF_ACCELERATION_TYPE accel = AMF_ACCEL_NOT_SUPPORTED;
+        res = ctx->decoder->pVtbl->GetCaps(ctx->decoder, &caps);
+        if (res == AMF_OK && caps) {
+            accel = caps->pVtbl->GetAccelerationType(caps);
+            caps->pVtbl->Release(caps);
+        }
+        if (res != AMF_OK || accel == AMF_ACCEL_NOT_SUPPORTED) {
+            av_log(avctx, AV_LOG_ERROR, "AMF has no hardware decoder for %ls on this device (GetCaps %d, acceleration %d)\n",
+                   codec_id, res, accel);
+            // never initialized, so Release without Terminate
+            ctx->decoder->pVtbl->Release(ctx->decoder);
+            ctx->decoder = NULL;
+            return AVERROR(ENOSYS);
+        }
+    }
+
     // Color Metadata
     /// Color Range (Support for older Drivers)
     if (avctx->color_range == AVCOL_RANGE_JPEG) {
@@ -718,3 +746,5 @@ DEFINE_AMF_DECODER(h264, H264, "h264_mp4toannexb")
 DEFINE_AMF_DECODER(hevc, HEVC, NULL)
 DEFINE_AMF_DECODER(vp9, VP9, NULL)
 DEFINE_AMF_DECODER(av1, AV1, NULL)
+DEFINE_AMF_DECODER(mpeg2, MPEG2VIDEO, NULL)
+DEFINE_AMF_DECODER(vc1, VC1, NULL)
