+     * has been stripped. Confirm intra reference slices before using it. */
+    if (avctx->codec_id == AV_CODEC_ID_H264 && !recovery_sei &&
+        leading && all_intra && (pkt->flags & AV_PKT_FLAG_KEY))
+        *recovery_point = 1;
+    return leading;
+}
