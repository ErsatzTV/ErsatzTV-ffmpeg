+/* A conservative startup classifier. Unknown headers are never grounds for
+ * discarding a picture. H.264 accepts an immediate recovery point, or a
+ * key-flagged reference I-picture when no recovery SEI is present. An explicit
+ * delayed recovery point must not take that fallback. IDR pictures recover in
+ * decode order, including pictures which precede them in display order. */
+static int amf_leading_picture(AVCodecContext *avctx, const AVPacket *pkt,
+                              int *recovery_point)
+{
+    AMFDecoderContext *ctx = avctx->priv_data;
+    int i, flags = 0, length_size = 0, leading = 0;
+    int recovery_sei = 0, all_intra = 1;
+
+    *recovery_point = 0;
+    if (avctx->codec_id == AV_CODEC_ID_MPEG2VIDEO) {
+        const uint8_t *p = pkt->data, *end = p + pkt->size;
+        uint32_t state = -1;
+        while (p < end) {
+            p = avpriv_find_start_code(p, end, &state);
+            if (state == GOP_START_CODE && end - p >= 4)
+                ctx->closed_gop = !!(p[3] & 0x40);
+            if (state == PICTURE_START_CODE && end - p >= 2)
+                return ctx->closed_gop == 0 && ((p[1] >> 3) & 7) == AV_PICTURE_TYPE_B;
+        }
+        return 0;
+    }
+    if (avctx->codec_id != AV_CODEC_ID_H264 && avctx->codec_id != AV_CODEC_ID_HEVC)
+        return 0;
+
+    /* h264_mp4toannexb supplies Annex B. HEVC is also accepted in hvcC form. */
+    if (avctx->codec_id == AV_CODEC_ID_HEVC && avctx->extradata_size >= 23 &&
+        avctx->extradata[0] == 1) {
+        flags = H2645_FLAG_IS_NALFF;
+        length_size = (avctx->extradata[21] & 3) + 1;
+    }
+    if (ff_h2645_packet_split(&ctx->leading_pkt, pkt->data, pkt->size, avctx,
+                             length_size, avctx->codec_id, flags) < 0)
+        return 0;
+
+    for (i = 0; i < ctx->leading_pkt.nb_nals; i++) {
+        const H2645NAL *nal = &ctx->leading_pkt.nals[i];
+        if (avctx->codec_id == AV_CODEC_ID_HEVC) {
+            if (nal->type <= HEVC_NAL_RSV_VCL31)
+                return nal->type == HEVC_NAL_RASL_N || nal->type == HEVC_NAL_RASL_R;
+        } else {
+            if (nal->type == H264_NAL_IDR_SLICE) {
+                /* Do not start timestamp-based recovery at a later keyframe. */
+                ctx->recovered = 1;
+                return 0;
+            }
+            if (nal->type == H264_NAL_SLICE) {
+                GetBitContext gb = nal->gb;
+                unsigned slice_type;
+
+                leading = 1;
+                get_ue_golomb_long(&gb); // first_mb_in_slice
+                slice_type = get_ue_golomb_long(&gb);
+                all_intra &= get_bits_left(&gb) > 0 && nal->ref_idc &&
+                             (slice_type == 2 || slice_type == 7);
+            }
+            if (nal->type == H264_NAL_SEI) {
+                const uint8_t *p = nal->data + 1, *end = nal->data + nal->size;
+                while (end - p >= 2) {
+                    unsigned type = 0, size = 0;
+                    while (p < end && *p == 255) {
+                        type += 255;
+                        p++;
+                    }
+                    if (p == end) {
+                        recovery_sei = 1; // malformed SEI: do not infer recovery
+                        break;
+                    }
+                    type += *p++;
+                    while (p < end && *p == 255) {
+                        size += 255;
+                        p++;
+                    }
+                    if (p == end) {
+                        recovery_sei = 1; // malformed SEI: do not infer recovery
+                        break;
+                    }
+                    size += *p++;
+                    if (size > end - p) {
+                        recovery_sei = 1;
+                        break;
+                    }
+                    /* recovery_frame_cnt is ue(v); a leading 1 means zero. */
+                    if (type == SEI_TYPE_RECOVERY_POINT) {
+                        recovery_sei = 1;
+                        *recovery_point = size > 0 && (p[0] & 0x80);
+                    }
+                    p += size;
+                }
+            }
+        }
+    }
