+    struct pl_color_repr inline_nv12_repr;
+
     // Map of acquired frames
     struct {
         bool target, image, prev, next;
@@ -2640,6 +2661,215 @@
                                                   PL_INTENT_RELATIVE_COLORIMETRIC);
     pl_matrix3x3_apply(&tr, out_color);
