+int ff_qsv_frames_ctx_replace(QSVFramesContext *ctx, AVBufferRef *hw_frames_ref)
+{
+    AVHWFramesContext    *frames_ctx = (AVHWFramesContext*)hw_frames_ref->data;
+    AVQSVFramesContext *frames_hwctx = frames_ctx->hwctx;
+    AVBufferRef *ref, *old_ref = ctx->hw_frames_ctx;
+    QSVMid *mids, *old_mids = ctx->mids;
+
+    if (!frames_hwctx->nb_surfaces)
+        return AVERROR(ENOSYS);
+
+    ref = av_buffer_ref(hw_frames_ref);
+    if (!ref)
+        return AVERROR(ENOMEM);
+
+    mids = qsv_create_mids(hw_frames_ref);
+    if (!mids) {
+        av_buffer_unref(&ref);
+        return AVERROR(ENOMEM);
+    }
+
+    /* the session's allocator reads ctx, so never leave it pointing at
+     * nothing; queued frames keep the old frames context alive */
+    ctx->hw_frames_ctx = ref;
+    ctx->mids          = mids;
+    ctx->nb_mids       = frames_hwctx->nb_surfaces;
+    av_buffer_unref(&old_ref);
+    av_refstruct_unref(&old_mids);
+
+    return 0;
+}
