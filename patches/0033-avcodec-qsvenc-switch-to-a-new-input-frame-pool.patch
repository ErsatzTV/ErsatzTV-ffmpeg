+/* A reconfigured filtergraph hands the encoder frames from a new fixed pool,
+ * whose surfaces are not in the memory ids the session was opened with. */
+static int switch_frames_ctx(QSVEncContext *q, AVBufferRef *hw_frames_ref)
+{
+    AVHWFramesContext *cur = (AVHWFramesContext*)q->frames_ctx.hw_frames_ctx->data;
+    AVHWFramesContext *new = (AVHWFramesContext*)hw_frames_ref->data;
+    AVQSVFramesContext *new_hwctx = new->hwctx;
+
+    if (new->device_ref->data != cur->device_ref->data ||
+        new->sw_format != cur->sw_format ||
+        new->width != cur->width || new->height != cur->height ||
+        !new_hwctx->nb_surfaces) {
+        av_log(q->avctx, AV_LOG_ERROR, "Input frames come from a frame pool "
+               "the encoder cannot switch to: %s %dx%d, %d surfaces; the "
+               "encoder was opened with %s %dx%d\n",
+               av_get_pix_fmt_name(new->sw_format), new->width, new->height,
+               new_hwctx->nb_surfaces, av_get_pix_fmt_name(cur->sw_format),
+               cur->width, cur->height);
+        return AVERROR(EINVAL);
+    }
+
+    av_log(q->avctx, AV_LOG_VERBOSE, "Input frames come from a new frame pool, "
+           "switching to it\n");
+
+    return ff_qsv_frames_ctx_replace(&q->frames_ctx, hw_frames_ref);
+}
